# Скопируйте этот файл в .env и заполните токен Discord-бота.
# Токен обязателен для основного процесса; CLI и миграции его не требуют.
DISCORD_TOKEN=

# Путь к SQLite. По умолчанию: ./data/temp-voice.sqlite.
# Относительный путь считается от рабочего каталога. В Docker используйте /data/temp-voice.sqlite.
DATABASE_PATH=./data/temp-voice.sqlite

# Необязательно: путь к временному файлу готовности процесса.
# По умолчанию: temp-voice-health.json в системном временном каталоге.
# Пример для Linux/Docker, вне постоянного тома:
# HEALTH_FILE_PATH=/tmp/temp-voice-health.json
