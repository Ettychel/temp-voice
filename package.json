{
  "name": "temp-voice",
  "version": "0.0.0",
  "type": "module",
  "description": "",
  "homepage": "https://github.com/Ettychel/temp-voice#readme",
  "bugs": {
    "url": "https://github.com/Ettychel/temp-voice/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ettychel/temp-voice.git"
  },
  "license": "MIT",
  "author": "Yeti",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check": "npm run format && npm run typecheck && npm run build",
    "migration:generate": "npm run build && typeorm migration:generate -d dist/DatabaseDataSource.js",
    "migration:run": "npm run build && typeorm migration:run -d dist/DatabaseDataSource.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/DatabaseDataSource.js",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "tsc-watch --project tsconfig.build.json --onSuccess \"node --enable-source-maps dist/main.js\"",
    "owner:recover": "node --enable-source-maps dist/console.js owner:recover",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "npm run lint:fix && prettier --write . && npm run lint && npm run format:check",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "necord@7.1.1": false
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/sprintf-js": "1.1.4",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-explicit-exceptions": "0.13.3",
    "eslint-plugin-jsdoc": "65.4.5",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsc-watch": "7.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "nest-commander": {
      "@golevelup/nestjs-discovery": "7.1.0"
    },
    "eslint-plugin-explicit-exceptions": {
      "eslint": "$eslint"
    }
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/typeorm": "12.0.3",
    "better-sqlite3": "12.11.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "discord-api-types": "0.37.120",
    "discord.js": "14.28.1",
    "necord": "7.1.1",
    "nest-commander": "3.21.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sprintf-js": "1.1.3",
    "typeorm": "1.1.3"
  }
}
